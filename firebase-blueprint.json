{
  "entities": {
    "Prompt": {
      "title": "Prompt",
      "description": "AI image/creative prompt stored in the prompt warehouse.",
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "description": "Display title of the prompt.",
          "minLength": 1,
          "maxLength": 120
        },
        "category": {
          "type": "string",
          "description": "Prompt category.",
          "enum": [
            "사진 합성",
            "스타일 변환",
            "캐릭터·포스터"
          ]
        },
        "content": {
          "type": "string",
          "description": "Full multi-line prompt text (supports well over 1,000 characters).",
          "minLength": 1,
          "maxLength": 20000
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when the prompt was created."
        }
      },
      "required": [
        "title",
        "category",
        "content",
        "createdAt"
      ]
    }
  },
  "firestore": {
    "/prompts/{promptId}": {
      "schema": {
        "$ref": "#/entities/Prompt"
      },
      "description": "Public collection of beginner-friendly AI prompts ordered by creation time."
    }
  }
}
